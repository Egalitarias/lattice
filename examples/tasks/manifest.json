{
  "lattice": "0.1",
  "app": "tasks.localhost",
  "name": "Lattice Tasks",
  "description": "Reference app: a todo list whose state lives on the server, reached over typed RPC.",
  "version": "0.1.0",
  "lang": "en",
  "entry": "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
  "routes": {
    "/": "Home",
    "/about": "About"
  },
  "api": {
    "url": "https://tasks.localhost/rpc",
    "schema": "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
  },
  "capabilities": {
    "requires": [
      "net.origin",
      "session",
      "auth.oidc",
      "auth.passkey",
      "payments.request",
      "analytics.event"
    ]
  },
  "actions": [
    {
      "name": "add_task",
      "description": "Add a task to the list.",
      "effect": "write",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      }
    }
  ],
  "fallback": {
    "html": "/"
  },
  "auth": {
    "providers": [
      {
        "type": "passkey"
      }
    ],
    "token_endpoint": "https://tasks.localhost/auth/token"
  },
  "payments": {
    "handlers": [
      "stripe"
    ],
    "merchant": {
      "domain": "tasks.localhost"
    },
    "server": "https://tasks.localhost/pay"
  },
  "analytics": {
    "processors": [
      {
        "name": "Lattice Tasks (first party)",
        "endpoint": "https://tasks.localhost/events",
        "purposes": [
          "product",
          "performance",
          "errors"
        ]
      }
    ],
    "events": [
      {
        "name": "task_added",
        "description": "A task was added",
        "props": {
          "tasks": {
            "type": "integer"
          }
        }
      },
      {
        "name": "task_done",
        "description": "A task was marked done or not done",
        "props": {
          "done": {
            "type": "boolean"
          }
        }
      },
      {
        "name": "task_deleted",
        "description": "A task was deleted"
      },
      {
        "name": "signed_in",
        "description": "The user signed in",
        "props": {
          "method": {
            "type": "string",
            "enum": [
              "passkey",
              "oidc"
            ]
          }
        }
      },
      {
        "name": "signed_out",
        "description": "The user signed out"
      },
      {
        "name": "upgrade_started",
        "description": "The user pressed Upgrade to Pro"
      },
      {
        "name": "upgrade_confirmed",
        "description": "The server confirmed Pro"
      }
    ]
  }
}
