package lattice:app@0.1.0;

/// Host-provided interfaces. Each import is the linkable form of a capability in `capabilities.md`.
/// The host links an import only if the manifest requests the matching capability; a component
/// that imports anything else fails to instantiate. That is how "no ambient authority" is enforced.

interface log {
    enum level { debug, info, warn, error }

    write: func(level: level, message: string);
}

/// Capability: net.origin
interface rpc {
    use types.{host-error};

    record application-error {
        /// Stable machine-readable code defined by the app's API schema.
        code: string,
        message: string,
        /// CBOR, schema-defined. May be empty.
        details: list<u8>,
    }

    variant rpc-error {
        host(host-error),
        application(application-error),
        /// Network or protocol failure. The host attaches the session to the request.
        transport(string),
    }

    /// Typed call against the manifest `api.url`; see rpc.md. `request` and the response are CBOR
    /// whose shape is fixed by the API description named in `api.schema`. The host validates both
    /// directions, so a response the app receives has already matched its schema. Blocks the
    /// caller's turn until the server answers or the host's timeout (10 s) expires.
    call: func(method: string, request: list<u8>) -> result<list<u8>, rpc-error>;

    /// Capability: net.realtime. Delivers `host-event.stream-message` for `topic`, which the API description must declare
    /// (see rpc.md, Topics). Fails with `invalid-argument` for an undeclared topic and `rate-limited` past 8 subscriptions.
    /// The first message is normally the server's current snapshot.
    subscribe: func(topic: string) -> result<_, host-error>;

    unsubscribe: func(topic: string);
}

/// Capability: experiments
interface experiments {
    use types.{host-error};

    /// The variant of the named experiment (declared in manifest `experiments`) that this user is in. The host assigned
    /// it once, at random, and remembers it on this device; a user who opted out is always in the first (control)
    /// variant. Looking a variant up records an exposure, which analytics sends only as the user's level allows.
    /// Fails with `invalid-argument` for an experiment the manifest does not declare.
    lookup: func(name: string) -> result<string, host-error>;
}

/// Capability: gpu.surface (see capabilities.md). A rectangle of pixels the app paints and the host shows in a `canvas` node.
/// The app renders in its own memory, in the sandbox, and hands over whole frames; it never touches the display, and the
/// host decides how often a frame is shown. This is not a GPU command interface.
interface surface {
    use types.{host-error};

    /// A surface of `width` x `height` pixels (each 1 to 1024, at most 786432 pixels in all). Fails with `invalid-argument`
    /// for a size outside that, and `rate-limited` when the app already holds 2 surfaces. Name it in `canvas.surface`.
    create: func(width: u32, height: u32) -> result<string, host-error>;

    /// Replace the surface's pixels. `pixels` is exactly width x height x 4 bytes: RGBA, 8 bits each, rows from the top,
    /// straight (not premultiplied) alpha. Fails with `invalid-argument` for an unknown surface or the wrong length, and
    /// `rate-limited` past about 30 frames a second. The host shows the newest frame it has when it next draws.
    present: func(handle: string, pixels: list<u8>) -> result<_, host-error>;

    /// Let go of the surface. A canvas that still names it makes the scene invalid.
    destroy: func(handle: string);
}

/// Capability: storage.local (and storage.sync, which replicates the same namespace)
interface storage {
    use types.{host-error};

    get: func(key: string) -> result<option<list<u8>>, host-error>;

    set: func(key: string, value: list<u8>) -> result<_, host-error>;

    delete: func(key: string) -> result<_, host-error>;

    list-keys: func(prefix: string) -> result<list<string>, host-error>;
}

/// Navigation within and out of the app.
interface navigation {
    use types.{host-error};

    enum mode { push, replace }

    /// Same-origin path. The host resolves it through the manifest routes and calls `app.route`.
    go: func(path: string, mode: mode) -> result<_, host-error>;

    back: func();

    /// Capability: navigate.external. Opens an https URL in an isolated system view.
    open-external: func(url: string) -> result<_, host-error>;
}

/// Capability: session
interface session {
    record info {
        signed-in: bool,
        /// Opaque user identifier chosen by the app's server. The token itself is never exposed.
        subject: option<string>,
        /// Unix seconds.
        expires-at: option<u64>,
    }

    current: func() -> info;

    /// Tells the server to revoke the session (`grant: revoke` at `auth.token_endpoint`, if declared),
    /// then replaces the host-held session with a fresh anonymous one.
    sign-out: func();
}

/// Capabilities: auth.passkey, auth.oidc
interface auth {
    use types.{host-error};
    use session.{info};

    /// Runs the OIDC authorization-code + PKCE flow for the manifest provider with this
    /// `issuer`, then sends the code to `auth.token_endpoint`, whose server verifies the ID token and
    /// answers with a session (spec/auth.md). The host holds the verifier and the session; the app
    /// never sees the code or any token. Blocks until the user finishes or cancels (`cancelled`).
    /// Requires `auth.oidc`.
    sign-in-oidc: func(issuer: string) -> result<info, host-error>;

    /// Creates a passkey. `options` is the server-issued WebAuthn creation options (UTF-8 JSON, the
    /// WebAuthn `PublicKeyCredentialCreationOptionsJSON`). The host requires `rp.id` to equal the app's
    /// domain, drops extensions, and asks the user in its own dialog. Returns the registration
    /// response (UTF-8 JSON) for the app to send to its server. Requires `auth.passkey`.
    passkey-create: func(options: list<u8>) -> result<list<u8>, host-error>;

    /// Asserts with a passkey. `options` is the server-issued request options (UTF-8 JSON,
    /// `PublicKeyCredentialRequestOptionsJSON`); `rpId`, if present, must equal the app's domain.
    /// Returns the authentication response (UTF-8 JSON). Requires `auth.passkey`.
    passkey-assert: func(options: list<u8>) -> result<list<u8>, host-error>;
}

/// Capability: payments.request (hosted checkout; see spec/payments.md)
interface payments {
    use types.{host-error};

    /// The user finished the processor's flow and was sent back. This is NOT proof of payment: the
    /// app must ask its own server, which acts only on the processor's signed webhook.
    record payment-receipt {
        order-ref: string,
        /// The processor that handled it, e.g. "stripe".
        handler: string,
    }

    /// Ask the user to pay for an order the app's server has already created. The app supplies only
    /// the order reference. The host gets the amount and the checkout URL from the server itself,
    /// shows a sheet drawn from that, opens the processor's page, and waits for the user to return.
    /// The app never sees card details, a price it chose, or a URL it chose.
    /// Errors: `cancelled` (the user declined or closed the checkout), `invalid-argument` (the server
    /// refused the order, or sent something the host will not show), `unavailable`.
    request: func(order-ref: string) -> result<payment-receipt, host-error>;
}

/// Capability: analytics.event (see spec/analytics.md)
interface analytics {
    use types.{args};

    /// Record a product event. Fire and forget: there is no result and no error, so an app cannot
    /// tell whether anything was sent, and cannot be slowed by it. `name` and `props` are checked
    /// against the catalog in manifest `analytics.events`; an event that is not declared, or has an
    /// undeclared or mistyped property, is dropped whole. What is actually sent depends on the user's
    /// analytics level and on the processors the manifest declares; the host does the sending, and
    /// scrubs anything that matches a value the user typed into a `sensitive` input.
    emit: func(name: string, props: args);

    /// Report a failure the app handled or noticed. `name` is a short stable identifier
    /// ("payment_confirm_failed"); `detail` is free text for developers and is scrubbed of emails,
    /// long numbers and tokens and truncated to 200 characters. Sent only at the "errors" level or above,
    /// to processors declared for `errors`. Fire and forget.
    report-error: func(name: string, detail: string);
}

/// Capability: notifications
interface notifications {
    use types.{host-error};

    record push-subscription {
        /// Opaque endpoint and keys for the app's server to push to (Web Push compatible).
        endpoint: string,
        p256dh: list<u8>,
        auth: list<u8>,
    }

    subscribe-push: func() -> result<push-subscription, host-error>;
}

/// Capability: consent
interface consent {
    use types.{host-error};

    record receipt {
        kind: string,
        document-version: string,
        /// Unix seconds.
        recorded-at: u64,
        /// Host-signed over (origin, kind, document-version, recorded-at).
        signature: list<u8>,
    }

    /// Shows the host consent prompt and records the outcome. `cancelled` means refused.
    request: func(kind: string, document-version: string) -> result<receipt, host-error>;
}
